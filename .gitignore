# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env
.env.local

# Landing zone and warehouse — regenerated by ingestion, published to
# Hugging Face rather than committed here. Feed state is machine-local.
/data/raw/
/data/state/
/data/*.duckdb
/data/*.duckdb.wal
/data/.duckdb-tmp/

# dbt build output. `target/` is compiled SQL regenerated by every build, and
# `.user.yml` is an anonymous machine id — neither belongs in the history.
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Keep small fixtures used by tests
!/tests/fixtures/

# Tooling
.DS_Store
*.log
