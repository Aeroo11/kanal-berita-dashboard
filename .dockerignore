# Keep the serving image to what it needs to serve.
.git
.github
.venv
.ruff_cache
.pytest_cache
.mypy_cache
__pycache__
*.pyc

# The warehouse, the landing zone and the exported dataset are all inputs to
# training, not to serving. Shipping them would multiply the image size for
# files the API never opens.
data/raw
data/warehouse
data/export
data/evaluation
data/*.duckdb
data/*.duckdb.wal
data/.duckdb-tmp
data/state
data/registry/_staging
data/registry-e2e
kanal-snapshot.parquet
.dagster_home
dbt/target
dbt/logs

tests
docs
scripts
